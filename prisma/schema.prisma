generator client {
  provider = "prisma-client"
  output   = "../src/data/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DriverRole {
  RACE_DRIVER
  RESERVE_DRIVER
}

model GameDatabase {
  id            String    @id @default(uuid()) @db.Uuid
  key           String    @unique
  name          String
  version       String
  schemaVersion Int       @default(1)
  description   String?
  isBuiltIn     Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  teams         Team[]
  drivers       Driver[]
  circuits      Circuit[]
  seasons       Season[]
}

model Team {
  id             String            @id @default(uuid()) @db.Uuid
  gameDatabaseId String            @db.Uuid
  key            String
  name           String
  shortName      String
  color          String            @db.VarChar(7)
  secondaryColor String?           @db.VarChar(7)
  countryCode    String            @db.VarChar(2)
  foundedYear    Int?
  seasonEntries  SeasonTeamEntry[]
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  gameDatabase   GameDatabase      @relation(fields: [gameDatabaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([gameDatabaseId, key])
  @@unique([gameDatabaseId, id])
}

model Driver {
  id              String              @id @default(uuid()) @db.Uuid
  gameDatabaseId  String              @db.Uuid
  key             String
  firstName       String
  lastName        String
  abbreviation    String
  dateOfBirth     DateTime            @db.Date
  nationalityCode String              @db.VarChar(2)
  preferredNumber Int?
  seasonEntries   SeasonDriverEntry[]
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  gameDatabase    GameDatabase        @relation(fields: [gameDatabaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([gameDatabaseId, key])
  @@unique([gameDatabaseId, id])
}

model Circuit {
  id              String          @id @default(uuid()) @db.Uuid
  gameDatabaseId  String          @db.Uuid
  key             String
  name            String
  countryCode     String          @db.VarChar(2)
  city            String?
  lengthMeters    Int
  defaultLapCount Int
  events          CalendarEvent[]
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  gameDatabase    GameDatabase    @relation(fields: [gameDatabaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([gameDatabaseId, key])
  @@unique([gameDatabaseId, id])
}

model Season {
  id             String            @id @default(uuid()) @db.Uuid
  gameDatabaseId String            @db.Uuid
  key            String
  year           Int
  name           String
  teams          SeasonTeamEntry[]
  events         CalendarEvent[]
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  gameDatabase   GameDatabase      @relation(fields: [gameDatabaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([gameDatabaseId, key])
  @@unique([gameDatabaseId, id])
}

model SeasonTeamEntry {
  id             String              @id @default(uuid()) @db.Uuid
  gameDatabaseId String              @db.Uuid
  seasonId       String              @db.Uuid
  teamId         String              @db.Uuid
  entryOrder     Int
  season         Season              @relation(fields: [gameDatabaseId, seasonId], references: [gameDatabaseId, id], onDelete: Restrict, onUpdate: Restrict)
  team           Team                @relation(fields: [gameDatabaseId, teamId], references: [gameDatabaseId, id], onDelete: Restrict, onUpdate: Restrict)
  drivers        SeasonDriverEntry[]

  @@unique([gameDatabaseId, seasonId, teamId])
  @@unique([gameDatabaseId, seasonId, entryOrder])
  @@index([gameDatabaseId, teamId])
}

model SeasonDriverEntry {
  id             String          @id @default(uuid()) @db.Uuid
  gameDatabaseId String          @db.Uuid
  seasonId       String          @db.Uuid
  driverId       String          @db.Uuid
  teamId         String          @db.Uuid
  carNumber      Int?
  role           DriverRole
  teamEntry      SeasonTeamEntry @relation(fields: [gameDatabaseId, seasonId, teamId], references: [gameDatabaseId, seasonId, teamId], onDelete: Restrict, onUpdate: Restrict)
  driver         Driver          @relation(fields: [gameDatabaseId, driverId], references: [gameDatabaseId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([gameDatabaseId, seasonId, driverId])
  @@unique([gameDatabaseId, seasonId, carNumber])
  @@index([gameDatabaseId, driverId])
  @@index([gameDatabaseId, seasonId, teamId])
}

model CalendarEvent {
  id             String   @id @default(uuid()) @db.Uuid
  gameDatabaseId String   @db.Uuid
  seasonId       String   @db.Uuid
  circuitId      String   @db.Uuid
  round          Int
  name           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  season         Season   @relation(fields: [gameDatabaseId, seasonId], references: [gameDatabaseId, id], onDelete: Restrict, onUpdate: Restrict)
  circuit        Circuit  @relation(fields: [gameDatabaseId, circuitId], references: [gameDatabaseId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([gameDatabaseId, seasonId, round])
  @@index([gameDatabaseId, circuitId])
}

// Career provenance IDs are scalar metadata, deliberately NOT foreign keys to source content.
enum CareerStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum CareerSeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum CareerEventStatus {
  UPCOMING
  CURRENT
  COMPLETED
}

model Career {
  id                        String          @id @default(uuid()) @db.Uuid
  name                      String          @db.VarChar(80)
  sourceGameDatabaseId      String          @db.Uuid
  sourceGameDatabaseVersion String
  sourceSeasonId            String          @db.Uuid
  currentDate               DateTime        @db.Date
  playerTeamId              String          @db.Uuid
  currentSeasonId           String          @db.Uuid
  status                    CareerStatus    @default(ACTIVE)
  createdAt                 DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime        @updatedAt @db.Timestamptz(3)
  playerTeam                CareerTeam      @relation("PlayerTeam", fields: [id, playerTeamId], references: [careerId, id], onDelete: NoAction, onUpdate: NoAction)
  currentSeason             CareerSeason    @relation("CurrentSeason", fields: [id, currentSeasonId], references: [careerId, id], onDelete: NoAction, onUpdate: NoAction)
  teams                     CareerTeam[]    @relation("WorldTeams")
  drivers                   CareerDriver[]
  circuits                  CareerCircuit[]
  seasons                   CareerSeason[]  @relation("WorldSeasons")

  @@index([updatedAt, id])
}

model CareerTeam {
  id             String                  @id @default(uuid()) @db.Uuid
  careerId       String                  @db.Uuid
  sourceTeamId   String?                 @db.Uuid
  key            String
  name           String
  shortName      String
  color          String                  @db.VarChar(7)
  secondaryColor String?                 @db.VarChar(7)
  countryCode    String                  @db.VarChar(2)
  foundedYear    Int?
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  career         Career                  @relation("WorldTeams", fields: [careerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  playerFor      Career[]                @relation("PlayerTeam")
  entries        CareerSeasonTeamEntry[]

  raceEntrants CareerRaceEntrant[]

  @@unique([careerId, id])
  @@unique([careerId, key])
}

model CareerDriver {
  id              String                    @id @default(uuid()) @db.Uuid
  careerId        String                    @db.Uuid
  sourceDriverId  String?                   @db.Uuid
  key             String
  firstName       String
  lastName        String
  abbreviation    String
  dateOfBirth     DateTime                  @db.Date
  nationalityCode String                    @db.VarChar(2)
  preferredNumber Int?
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)
  career          Career                    @relation(fields: [careerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entries         CareerSeasonDriverEntry[]

  raceEntrants CareerRaceEntrant[]

  @@unique([careerId, id])
  @@unique([careerId, key])
}

model CareerCircuit {
  id              String                @id @default(uuid()) @db.Uuid
  careerId        String                @db.Uuid
  sourceCircuitId String?               @db.Uuid
  key             String
  name            String
  countryCode     String                @db.VarChar(2)
  city            String?
  lengthMeters    Int
  defaultLapCount Int
  career          Career                @relation(fields: [careerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  events          CareerCalendarEvent[]

  @@unique([careerId, id])
  @@unique([careerId, key])
}

model CareerSeason {
  id             String                  @id @default(uuid()) @db.Uuid
  careerId       String                  @db.Uuid
  sourceSeasonId String?                 @db.Uuid
  year           Int
  name           String
  status         CareerSeasonStatus      @default(UPCOMING)
  startDate      DateTime?               @db.Date
  endDate        DateTime?               @db.Date
  career         Career                  @relation("WorldSeasons", fields: [careerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentFor     Career[]                @relation("CurrentSeason")
  teams          CareerSeasonTeamEntry[]
  events         CareerCalendarEvent[]

  @@unique([careerId, id])
  @@unique([careerId, year])
}

model CareerSeasonTeamEntry {
  id             String                    @id @default(uuid()) @db.Uuid
  careerId       String                    @db.Uuid
  careerSeasonId String                    @db.Uuid
  careerTeamId   String                    @db.Uuid
  entryOrder     Int
  season         CareerSeason              @relation(fields: [careerId, careerSeasonId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)
  team           CareerTeam                @relation(fields: [careerId, careerTeamId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)
  drivers        CareerSeasonDriverEntry[]

  @@unique([careerId, careerSeasonId, id])
  @@unique([careerId, careerSeasonId, careerTeamId])
  @@unique([careerId, careerSeasonId, entryOrder])
  @@index([careerId, careerTeamId])
}

model CareerSeasonDriverEntry {
  id                      String                @id @default(uuid()) @db.Uuid
  careerId                String                @db.Uuid
  careerSeasonId          String                @db.Uuid
  careerDriverId          String                @db.Uuid
  careerSeasonTeamEntryId String                @db.Uuid
  carNumber               Int?
  role                    DriverRole
  teamEntry               CareerSeasonTeamEntry @relation(fields: [careerId, careerSeasonId, careerSeasonTeamEntryId], references: [careerId, careerSeasonId, id], onDelete: Restrict, onUpdate: Restrict)
  driver                  CareerDriver          @relation(fields: [careerId, careerDriverId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([careerId, careerSeasonId, careerDriverId])
  @@unique([careerId, careerSeasonId, carNumber])
  @@index([careerId, careerDriverId])
  @@index([careerId, careerSeasonId, careerSeasonTeamEntryId])
}

model CareerCalendarEvent {
  id                    String            @id @default(uuid()) @db.Uuid
  careerId              String            @db.Uuid
  careerSeasonId        String            @db.Uuid
  careerCircuitId       String            @db.Uuid
  sourceCalendarEventId String?           @db.Uuid
  round                 Int
  name                  String
  startDate             DateTime          @db.Date
  endDate               DateTime          @db.Date
  status                CareerEventStatus @default(UPCOMING)
  season                CareerSeason      @relation(fields: [careerId, careerSeasonId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)
  circuit               CareerCircuit     @relation(fields: [careerId, careerCircuitId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)

  weekend CareerRaceWeekend?

  @@unique([careerId, careerSeasonId, id])
  @@unique([careerId, careerSeasonId, round])
  @@index([careerId, careerCircuitId])
}

enum CareerWeekendStatus {
  ACTIVE
  COMPLETED
}

enum CareerSessionType {
  PRACTICE_1
  PRACTICE_2
  PRACTICE_3
  QUALIFYING
  RACE
}

enum CareerSessionStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model CareerRaceWeekend {
  id                    String              @id @default(uuid()) @db.Uuid
  careerId              String              @db.Uuid
  careerSeasonId        String              @db.Uuid
  careerCalendarEventId String              @unique @db.Uuid
  status                CareerWeekendStatus @default(ACTIVE)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)
  completedAt           DateTime?           @db.Timestamptz(3)
  event                 CareerCalendarEvent @relation(fields: [careerId, careerSeasonId, careerCalendarEventId], references: [careerId, careerSeasonId, id], onDelete: Restrict, onUpdate: Restrict)
  sessions              CareerSession[]

  @@unique([careerId, id])
  @@unique([careerId, careerSeasonId, careerCalendarEventId])
}

model CareerSession {
  id                    String              @id @default(uuid()) @db.Uuid
  careerId              String              @db.Uuid
  careerRaceWeekendId   String              @db.Uuid
  type                  CareerSessionType
  order                 Int
  status                CareerSessionStatus
  startedAtCareerDate   DateTime?           @db.Date
  completedAtCareerDate DateTime?           @db.Date
  weekend               CareerRaceWeekend   @relation(fields: [careerId, careerRaceWeekendId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)

  raceSimulation CareerRaceSimulation?

  @@unique([careerId, id, type])
  @@unique([careerRaceWeekendId, type])
  @@unique([careerRaceWeekendId, order])
  @@index([careerId, careerRaceWeekendId])
}

enum RaceSimulationStatus {
  RUNNING
  FINISHED
}

model CareerRaceSimulation {
  id                       String               @id @default(uuid()) @db.Uuid
  careerId                 String               @db.Uuid
  careerSessionId          String               @unique @db.Uuid
  sessionType              CareerSessionType    @default(RACE)
  simulationVersion        Int
  seed                     BigInt
  rngState                 BigInt
  currentLap               Int
  totalLaps                Int
  status                   RaceSimulationStatus
  baseLapTimeMs            Int
  fuelEffectMsPerKg        Float
  initialFuelGrams         Int
  fuelBurnPerLapGrams      Int
  carPerformanceRangeMs    Int
  driverPerformanceRangeMs Int
  minVariationMs           Int
  maxVariationMs           Int
  gridOffsetMs             Int
  createdAt                DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @db.Timestamptz(3)
  session                  CareerSession        @relation(fields: [careerId, careerSessionId, sessionType], references: [careerId, id, type], onDelete: Restrict, onUpdate: Restrict)
  entrants                 CareerRaceEntrant[]

  tyreWearMultiplierPermille   Int?
  tyreEnergyMultiplierPermille Int?
  tyreProfiles                 CareerRaceTyreProfile[]
  interactionProfile           CareerRaceInteractionProfile?

  commandProfile CareerRaceCommandProfile?
  pitProfile     CareerRacePitProfile?

  @@unique([careerId, id])
  @@unique([careerId, careerSessionId, sessionType])
}

model CareerRaceEntrant {
  paceMode               String?
  fuelMode               String?
  ersMode                String?
  ersCharge              Int?
  commandRevision        Int?
  id                     String               @id @db.Uuid
  careerId               String               @db.Uuid
  careerRaceSimulationId String               @db.Uuid
  careerDriverId         String               @db.Uuid
  careerTeamId           String               @db.Uuid
  driverName             String
  teamName               String
  gridPosition           Int
  driverPace             Float
  driverConsistency      Float
  carPerformance         Float
  completedLaps          Int
  elapsedTimeMs          Int
  lastLapTimeMs          Int?
  bestLapTimeMs          Int?
  fuelMassGrams          Int
  position               Int
  gapToLeaderMs          Int?
  intervalToAheadMs      Int?
  simulation             CareerRaceSimulation @relation(fields: [careerId, careerRaceSimulationId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)
  driver                 CareerDriver         @relation(fields: [careerId, careerDriverId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)
  team                   CareerTeam           @relation(fields: [careerId, careerTeamId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)

  startingCompound              TyreCompound?
  startingTyreAgeLaps           Int?
  startingTyreWearPermille      Int?
  startingTyreTemperatureMilliC Int?
  compound                      TyreCompound?
  tyreAgeLaps                   Int?
  tyreWearPermille              Int?
  tyreTemperatureMilliC         Int?
  stintNumber                   Int?
  stintStartedAtLap             Int?

  trackProgressMicrolaps BigInt?
  drsEligible            Boolean?
  overtakesCompleted     Int?
  potentialLapTimeMs     Int?
  dirtyAirMs             Int?
  drsBenefitMs           Int?
  trafficLossMs          Int?
  attempted              Boolean?
  passed                 Boolean?
  driverOvertaking       Int?
  driverDefending        Int?
  strategyController     RaceStrategyController?
  pendingPitCompound     TyreCompound?
  pitCommandRevision     Int?
  stopCount              Int?
  stintHistory           CareerRaceStint[]
  pitStops               CareerRacePitStop[]

  @@unique([careerRaceSimulationId, position])
  @@unique([careerId, careerRaceSimulationId, id])
  @@unique([careerRaceSimulationId, careerDriverId])
  @@unique([careerRaceSimulationId, gridPosition])
  @@index([careerId, careerDriverId])
  @@index([careerId, careerTeamId])
}

enum TyreCompound {
  SOFT
  MEDIUM
  HARD
}

model CareerRaceTyreProfile {
  careerId                  String               @db.Uuid
  careerRaceSimulationId    String               @db.Uuid
  compound                  TyreCompound
  baseGripDeltaMs           Int
  idealTemperatureMinMilliC Int
  idealTemperatureMaxMilliC Int
  coldPenaltyMsPerC         Int
  hotPenaltyMsPerC          Int
  maxTemperaturePenaltyMs   Int
  targetTemperatureMilliC   Int
  thermalResponsePermille   Int
  baseWearPerLapPermille    Int
  degradationStartWear      Int
  cliffWear                 Int
  stablePenaltyMs           Int
  progressivePenaltyMs      Int
  cliffPenaltyMs            Int
  simulation                CareerRaceSimulation @relation(fields: [careerId, careerRaceSimulationId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([careerRaceSimulationId, compound])
}

model CareerRaceInteractionProfile {
  careerRaceSimulationId      String               @id @db.Uuid
  careerId                    String               @db.Uuid
  overtakingDifficulty        Int
  dirtyAirSensitivityPermille Int
  drsEffectivenessPermille    Int
  drsZoneCount                Int
  dirtyAirThresholdMs         Int
  maxDirtyAirMs               Int
  attackThresholdMs           Int
  minimumGapMs                Int
  minimumPaceAdvantageMs      Int
  opportunityIntervalLaps     Int
  drsActivationLap            Int
  drsThresholdMs              Int
  drsMsPerZone                Int
  maxDrsBenefitMs             Int
  simulation                  CareerRaceSimulation @relation(fields: [careerId, careerRaceSimulationId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([careerId, careerRaceSimulationId])
}

enum RaceStrategyController {
  PLAYER
  DEVELOPMENT_AI
}

model CareerRacePitProfile {
  careerRaceSimulationId   String               @id @db.Uuid
  careerId                 String               @db.Uuid
  pitLaneLossMs            Int
  stationaryBaseMs         Int
  stationaryVariationMs    Int
  newTyreTemperatureMilliC Int
  aiWearThresholdPermille  Int
  aiMinimumStintLaps       Int
  simulation               CareerRaceSimulation @relation(fields: [careerId, careerRaceSimulationId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([careerId, careerRaceSimulationId])
}

model CareerRaceStint {
  careerId                  String            @db.Uuid
  careerRaceSimulationId    String            @db.Uuid
  entrantId                 String            @db.Uuid
  number                    Int
  startLap                  Int
  endLap                    Int?
  compound                  TyreCompound
  startingAgeLaps           Int
  startingWearPermille      Int
  startingTemperatureMilliC Int
  endingAgeLaps             Int?
  endingWearPermille        Int?
  endingTemperatureMilliC   Int?
  entrant                   CareerRaceEntrant @relation(fields: [careerId, careerRaceSimulationId, entrantId], references: [careerId, careerRaceSimulationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([entrantId, number])
}

model CareerRacePitStop {
  careerId               String            @db.Uuid
  careerRaceSimulationId String            @db.Uuid
  entrantId              String            @db.Uuid
  number                 Int
  lap                    Int
  oldCompound            TyreCompound
  newCompound            TyreCompound
  pitLaneLossMs          Int
  stationaryTimeMs       Int
  totalLossMs            Int
  entrant                CareerRaceEntrant @relation(fields: [careerId, careerRaceSimulationId, entrantId], references: [careerId, careerRaceSimulationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([entrantId, number])
  @@unique([entrantId, lap])
}

model CareerRaceCommandProfile {
  careerRaceSimulationId String               @id @db.Uuid
  careerId               String               @db.Uuid
  profile                Json
  simulation             CareerRaceSimulation @relation(fields: [careerId, careerRaceSimulationId], references: [careerId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([careerId, careerRaceSimulationId])
}
